-- zad 3
-- 3.1
SELECT last_name || ' ' || salary AS wynagrodzenie
FROM employees
WHERE department_id IN (20, 50)
  AND salary BETWEEN 2000 AND 7000
ORDER BY last_name;

-- 3.2
SELECT hire_date, last_name, &&kolumna
FROM employees
WHERE manager_id IS NOT NULL
  AND EXTRACT(YEAR FROM hire_date) = 2005
ORDER BY &kolumna;

UNDEFINE kolumna

-- 3.3
SELECT first_name || ' ' || last_name AS imie_nazwisko, salary, phone_number
FROM employees
WHERE last_name LIKE '__e%'
  AND UPPER(first_name) LIKE UPPER('%&fragment_imienia%')
ORDER BY 1 DESC, 2 ASC;

-- 3.4
SELECT first_name, last_name,
       ROUND(MONTHS_BETWEEN(SYSDATE, hire_date)) AS liczba_miesiecy,
       CASE
         WHEN ROUND(MONTHS_BETWEEN(SYSDATE, hire_date)) < 150 THEN salary * 0.1
         WHEN ROUND(MONTHS_BETWEEN(SYSDATE, hire_date)) < 200 THEN salary * 0.2
         ELSE salary * 0.3
       END AS wysokosc_dodatku
FROM employees
ORDER BY liczba_miesiecy;

-- 3.5
SELECT department_id, SUM(salary) AS suma_zarobkow, ROUND(AVG(salary)) AS srednia_zarobkow
FROM employees
WHERE department_id IS NOT NULL
GROUP BY department_id
HAVING MIN(salary) > 5000
ORDER BY department_id;

-- 3.6
SELECT e.last_name, e.department_id, d.department_name, e.job_id
FROM employees e
JOIN departments d ON e.department_id = d.department_id
JOIN locations l ON d.location_id = l.location_id
WHERE l.city = 'Toronto';

-- 3.7
SELECT j.first_name || ' ' || j.last_name AS pracownik,
       w.first_name || ' ' || w.last_name AS wspolpracownik
FROM employees j
LEFT JOIN employees w ON w.department_id = j.department_id AND w.employee_id <> j.employee_id
WHERE j.first_name = 'Jennifer'
ORDER BY 1, 2;

-- 3.8
SELECT d.department_id, d.department_name
FROM departments d
WHERE NOT EXISTS (SELECT 1 FROM employees e WHERE e.department_id = d.department_id)
ORDER BY d.department_id;

-- 3.9
SELECT e.first_name, e.last_name, e.job_id, d.department_name, e.salary, g.grade
FROM employees e
LEFT JOIN departments d ON e.department_id = d.department_id
LEFT JOIN job_grades g ON e.salary BETWEEN g.min_salary AND g.max_salary
ORDER BY e.last_name;

-- 3.10
SELECT first_name, last_name, salary
FROM employees
WHERE salary > (SELECT AVG(salary) FROM employees)
ORDER BY salary DESC;

-- 3.11
SELECT employee_id, first_name, last_name
FROM employees
WHERE department_id IN (SELECT department_id FROM employees WHERE last_name LIKE '%u%')
ORDER BY employee_id;

-- 3.12
SELECT employee_id, first_name, last_name, hire_date
FROM employees
WHERE SYSDATE - hire_date > (SELECT AVG(SYSDATE - hire_date) FROM employees)
ORDER BY hire_date;

-- 3.13
SELECT d.department_name, COUNT(e.employee_id) AS liczba_pracownikow, ROUND(AVG(e.salary), 2) AS srednie_wynagrodzenie
FROM departments d
LEFT JOIN employees e ON e.department_id = d.department_id
GROUP BY d.department_name
ORDER BY liczba_pracownikow DESC, d.department_name;

-- 3.14
SELECT first_name, last_name, salary
FROM employees
WHERE salary < ANY (SELECT e.salary
                    FROM employees e
                    JOIN departments d ON e.department_id = d.department_id
                    WHERE d.department_name = 'IT')
ORDER BY salary;

-- 3.15
SELECT d.department_id, d.department_name
FROM departments d
WHERE EXISTS (SELECT 1 FROM employees e
              WHERE e.department_id = d.department_id
                AND e.salary > (SELECT AVG(salary) FROM employees))
ORDER BY d.department_id;

-- 3.16
SELECT j.job_title, ROUND(AVG(e.salary)) AS srednie_zarobki
FROM employees e
JOIN jobs j ON e.job_id = j.job_id
GROUP BY j.job_title
ORDER BY AVG(e.salary) DESC, j.job_title
FETCH FIRST 5 ROWS ONLY;

-- 3.17
SELECT r.region_name,
       COUNT(DISTINCT c.country_id) AS liczba_krajow,
       COUNT(e.employee_id) AS liczba_pracownikow
FROM regions r
LEFT JOIN countries c ON c.region_id = r.region_id
LEFT JOIN locations l ON l.country_id = c.country_id
LEFT JOIN departments d ON d.location_id = l.location_id
LEFT JOIN employees e ON e.department_id = d.department_id
GROUP BY r.region_name
ORDER BY r.region_name;

-- 3.18
SELECT e.first_name, e.last_name, e.salary, m.last_name AS menedzer, m.salary AS zarobki_menedzera
FROM employees e
JOIN employees m ON e.manager_id = m.employee_id
WHERE e.salary > m.salary;

-- 3.19
SELECT EXTRACT(MONTH FROM hire_date) AS miesiac, COUNT(*) AS liczba_pracownikow
FROM employees
GROUP BY EXTRACT(MONTH FROM hire_date)
ORDER BY miesiac;

-- 3.20
SELECT d.department_name, ROUND(AVG(e.salary)) AS srednie_wynagrodzenie
FROM employees e
JOIN departments d ON e.department_id = d.department_id
GROUP BY d.department_name
ORDER BY AVG(e.salary) DESC
FETCH FIRST 3 ROWS ONLY;
