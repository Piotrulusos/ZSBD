-- zad 1
SELECT employee_id, first_name, last_name, salary,
       RANK() OVER (ORDER BY salary DESC) AS ranking
FROM employees
ORDER BY ranking;

-- zad 2
SELECT employee_id, first_name, last_name, salary,
       RANK() OVER (ORDER BY salary DESC) AS ranking,
       SUM(salary) OVER () AS suma_pensji
FROM employees
ORDER BY ranking;

-- zad 3
SELECT e.last_name, p.product_name, s.sale_date,
       s.price * s.quantity AS wartosc,
       SUM(s.price * s.quantity) OVER (PARTITION BY s.employee_id ORDER BY s.sale_date, s.sale_id) AS skumulowana_wartosc,
       RANK() OVER (ORDER BY s.price * s.quantity DESC) AS ranking
FROM sales s
JOIN employees e ON e.employee_id = s.employee_id
JOIN products p ON p.product_id = s.product_id
ORDER BY e.last_name, s.sale_date, s.sale_id;

-- zad 4
SELECT e.last_name, p.product_name, s.sale_date, s.price,
       COUNT(*) OVER (PARTITION BY s.product_id, TRUNC(s.sale_date)) AS liczba_transakcji,
       SUM(s.price * s.quantity) OVER (PARTITION BY s.product_id, TRUNC(s.sale_date)) AS suma_dnia,
       LAG(s.price) OVER (PARTITION BY s.product_id ORDER BY s.sale_date, s.sale_id) AS poprzednia_cena,
       LEAD(s.price) OVER (PARTITION BY s.product_id ORDER BY s.sale_date, s.sale_id) AS kolejna_cena
FROM sales s
JOIN employees e ON e.employee_id = s.employee_id
JOIN products p ON p.product_id = s.product_id
ORDER BY p.product_name, s.sale_date, s.sale_id;

-- zad 5
SELECT p.product_name, s.sale_date, s.price,
       SUM(s.price * s.quantity) OVER (PARTITION BY s.product_id, TRUNC(s.sale_date, 'MM')) AS suma_miesiaca,
       SUM(s.price * s.quantity) OVER (PARTITION BY s.product_id, TRUNC(s.sale_date, 'MM')
                                       ORDER BY s.sale_date, s.sale_id) AS suma_rosnaca
FROM sales s
JOIN products p ON p.product_id = s.product_id
ORDER BY p.product_name, s.sale_date, s.sale_id;

-- zad 6
SELECT p.product_name, p.product_category,
       TO_CHAR(s22.sale_date, 'DD-MM') AS dzien,
       s22.price AS cena_2022,
       s23.price AS cena_2023,
       s23.price - s22.price AS roznica
FROM sales s22
JOIN sales s23 ON s23.product_id = s22.product_id
              AND TO_CHAR(s23.sale_date, 'MM-DD') = TO_CHAR(s22.sale_date, 'MM-DD')
JOIN products p ON p.product_id = s22.product_id
WHERE EXTRACT(YEAR FROM s22.sale_date) = 2022
  AND EXTRACT(YEAR FROM s23.sale_date) = 2023
ORDER BY p.product_name, s22.sale_date;

-- zad 7
SELECT p.product_category, p.product_name, s.price,
       MIN(s.price) OVER (PARTITION BY p.product_category) AS min_cena,
       MAX(s.price) OVER (PARTITION BY p.product_category) AS max_cena,
       MAX(s.price) OVER (PARTITION BY p.product_category) - MIN(s.price) OVER (PARTITION BY p.product_category) AS roznica
FROM sales s
JOIN products p ON p.product_id = s.product_id
ORDER BY p.product_category, p.product_name, s.price;

-- zad 8
SELECT p.product_name, s.sale_date, s.price,
       ROUND(AVG(s.price) OVER (PARTITION BY s.product_id ORDER BY s.sale_date, s.sale_id
                                ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING), 2) AS srednia_kroczaca
FROM sales s
JOIN products p ON p.product_id = s.product_id
ORDER BY p.product_name, s.sale_date, s.sale_id;

-- zad 9
SELECT p.product_name, p.product_category, s.price,
       RANK() OVER (PARTITION BY p.product_category ORDER BY s.price DESC) AS ranking,
       ROW_NUMBER() OVER (PARTITION BY p.product_category ORDER BY s.price DESC) AS nr_wiersza,
       DENSE_RANK() OVER (PARTITION BY p.product_category ORDER BY s.price DESC) AS ranking_gesty
FROM sales s
JOIN products p ON p.product_id = s.product_id
ORDER BY p.product_category, s.price DESC;

-- zad 10
SELECT e.last_name, p.product_name, s.sale_date,
       s.price * s.quantity AS wartosc,
       SUM(s.price * s.quantity) OVER (PARTITION BY s.employee_id ORDER BY s.sale_date, s.sale_id) AS wartosc_rosnaca,
       RANK() OVER (ORDER BY s.price * s.quantity DESC) AS ranking
FROM sales s
JOIN employees e ON e.employee_id = s.employee_id
JOIN products p ON p.product_id = s.product_id
ORDER BY s.sale_date, s.sale_id;

-- zad 11
SELECT e.first_name, e.last_name, j.job_title
FROM employees e
JOIN jobs j ON j.job_id = e.job_id
WHERE e.employee_id IN (SELECT employee_id FROM sales)
ORDER BY e.last_name, e.first_name;
